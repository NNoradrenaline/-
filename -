-- Assist: Krillin kiblast redirect. Each kiblast part is pinned onto one random valid player
-- for a short hold; parts that arrive within the volley gap share that target.
---------------------------------------------------------------------------------------------
local krillin = {enabled = correctGame, teamMode = "enemies", fallback = false,
    volleyGap = 0.35, holdTime = 0.40, volleys = 0, last = "waiting for kiblast"}
state.Krillin = krillin
do
    local seen = setmetatable({}, {__mode = "k"})
    local volleyTarget, lastCatch = nil, -math.huge

    local function candidates(applyTeam)
        local list = {}
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= player then
                local root = Game.aliveRoot(targetPlayer.Character)
                if root and (not applyTeam or Game.teamAllows(targetPlayer, krillin.teamMode)) then
                    list[#list + 1] = root
                end
            end
        end
        return list
    end

    local function rollTarget()
        local list = candidates(true)
        if #list == 0 and krillin.fallback then list = candidates(false) end
        volleyTarget = #list > 0 and list[math.random(1, #list)] or nil
        lastCatch = os.clock()
        krillin.volleys = krillin.volleys + 1
        krillin.last = volleyTarget and ("volley " .. krillin.volleys .. " -> " .. volleyTarget.Parent.Name) or "no target"
        return volleyTarget
    end

    local function liveTarget()
        if volleyTarget and Game.aliveRoot(volleyTarget.Parent) then return volleyTarget end
        return nil
    end

    local function hold(part)
        RunService.Heartbeat:Wait()
        local stopAt = os.clock() + krillin.holdTime
        while alive and krillin.enabled and part.Parent and os.clock() < stopAt do
            local target = liveTarget() or rollTarget()
            if not target then break end
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.CFrame = target.CFrame
            RunService.Heartbeat:Wait()
        end
    end

    connect(workspace.DescendantAdded, function(part)
        if not krillin.enabled or seen[part] or not part:IsA("BasePart") then return end
        if not string.find(string.lower(part.Name), "kiblast", 1, true) then return end
        seen[part] = true
        if not liveTarget() or os.clock() - lastCatch > krillin.volleyGap then rollTarget() else lastCatch = os.clock() end
        task.spawn(hold, part)
    end)
end

---------------------------------------------------------------------------------------------
-- Auto Farm: pins us next to the best valid player and cycles the chosen inputs.
---------------------------------------------------------------------------------------------
local farm = {
    enabled = false, target = "none", last = "off",
    attacks = {["1"] = true, ["2"] = true, ["3"] = true, ["4"] = true, M1 = true, Mode = false},
    teamMode = "enemies", skipAfk = true, priority = "Nearest",
    avoidBlocking = true, avoidModeReady = false, maxRange = 0, stayOnTarget = true,
    onlyReady = true, sticky = true, aimCamera = true, standoff = 3, position = "Behind",
}
state.Farm = farm
do
    local current
    local lastRetarget = 0
    local lastModePress = -math.huge

    local positions = {
        Behind = function(root, d) return root.Position - root.CFrame.LookVector * d end,
        ["Behind + above"] = function(root, d) return root.Position - root.CFrame.LookVector * d + Vector3.new(0, 4, 0) end,
        Above = function(root, d) return root.Position + Vector3.new(0, d + 3, 0) end,
        Side = function(root, d) return root.Position + root.CFrame.RightVector * d end,
        Front = function(root, d) return root.Position + root.CFrame.LookVector * d end,
    }
    farm.positionOptions = {"Behind", "Behind + above", "Above", "Side", "Front"}

    -- Lower score wins. Avoid rules only push a player into a later tier, so the farm still
    -- falls back to them when nobody else is left.
    local scores = {
        ["Nearest"] = function(info) return info.distance end,
        ["Lowest HP"] = function(info) return info.health end,
        ["Lowest HP %"] = function(info) return info.health / math.max(info.maxHealth, 1) end,
        ["Most damage"] = function(info) return -info.damage end,
    }
    farm.priorityOptions = {"Nearest", "Lowest HP", "Lowest HP %", "Most damage"}

    local function eligible(targetPlayer)
        return targetPlayer ~= player and not (farm.skipAfk and Game.onAfkTeam(targetPlayer))
            and Game.teamAllows(targetPlayer, farm.teamMode)
    end

    local function choose()
        local ownRoot = Game.ownRoot()
        if not ownRoot then return nil end
        local score = scores[farm.priority] or scores.Nearest
        local best, bestTier, bestScore
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if eligible(targetPlayer) then
                local character = targetPlayer.Character
                local root, humanoid = Game.aliveRoot(character)
                if root then
                    local distance = (root.Position - ownRoot.Position).Magnitude
                    if farm.maxRange <= 0 or distance <= farm.maxRange then
                        local tier = 0
                        if farm.avoidBlocking and Game.isBlocking(character) then tier = tier + 1 end
                        if farm.avoidModeReady and Game.chargeFraction(targetPlayer) >= 1 then tier = tier + 1 end
                        local value = score({distance = distance, health = humanoid.Health,
                            maxHealth = humanoid.MaxHealth, damage = Game.stat(targetPlayer, "Damage")})
                        if not best or tier < bestTier or (tier == bestTier and value < bestScore) then
                            best = {root = root, name = targetPlayer.Name, player = targetPlayer}
                            bestTier, bestScore = tier, value
                        end
                    end
                end
            end
        end
        return best
    end
    farm.Preview = function()
        local best = choose()
        return best and best.name or nil
    end

    local function stillValid(target)
        return target ~= nil and Game.aliveRoot(target.root.Parent) ~= nil and target.player.Parent == Players
            and not (farm.skipAfk and Game.onAfkTeam(target.player))
    end

    -- A lost target is re-picked at most 4 times a second rather than every frame.
    local function updateTarget()
        if not stillValid(current) then
            if os.clock() - lastRetarget >= 0.25 then
                current = choose()
                lastRetarget = os.clock()
            else
                current = nil
            end
        elseif not farm.stayOnTarget and os.clock() - lastRetarget >= 1 then
            lastRetarget = os.clock()
            current = choose() or current
        end
        farm.target = current and current.name or "none"
        farm.targetPlayer = current and current.player or nil
    end
    farm.Retarget = function() current = nil end

    local function stick(targetRoot)
        local root = Game.ownRoot()
        if not root or not targetRoot.Parent then return end
        local compute = positions[farm.position] or positions.Behind
        root.CFrame = CFrame.lookAt(compute(targetRoot, farm.standoff), targetRoot.Position)
        root.AssemblyLinearVelocity = Vector3.zero
        if farm.aimCamera then
            local camera = workspace.CurrentCamera
            if camera then camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position) end
        end
    end

    -- Our mode bar: Player.Charge full and not blocked by NoAwaken.
    farm.ModeReady = function()
        return player:FindFirstChild("NoAwaken") == nil and Game.chargeFraction(player) >= 1
    end

    -- Fires the game's UseMode input action (bound to G). The server currently ignores it,
    -- so the toggle is labelled as not working.
    local function tryMode()
        if not farm.attacks.Mode or os.clock() - lastModePress < 2 or not farm.ModeReady() then return false end
        lastModePress = os.clock()
        local context = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("BaseContext")
        local action = context and context:FindFirstChild("UseMode")
        if action and action:IsA("InputAction") then
            action:Fire(true)
            task.wait(0.06)
            action:Fire(false)
        elseif canKeyClick then
            keyclick(0x47)
        end
        return true
    end

    farm.SetEnabled = function(value)
        farm.enabled = value == true and alive
        current = nil
        farm.last = farm.enabled and "running" or "off"
    end

    -- Every frame, so a target that turns around can't swing back into us.
    connect(RunService.Heartbeat, function()
        if not farm.enabled or not Game.ownRoot() then return end
        updateTarget()
        if current and farm.sticky then stick(current.root) end
    end)

    task.spawn(function()
        while alive do
            if farm.enabled then
                if not Game.ownRoot() then
                    current = nil
                    farm.target, farm.last = "none", "waiting to respawn"
                elseif not gameAction("MouseClick") and not canInput() then
                    -- only the old key-press path needs focus; the game's own actions don't
                    farm.last = "paused (roblox not focused)"
                else
                    updateTarget()
                    if not current then
                        farm.last = "no targets"
                        pcall(tryMode)
                    else
                        if not farm.sticky then stick(current.root) end
                        RunService.Heartbeat:Wait()
                        local actions = {}
                        local ok, reason = pcall(function()
                            if tryMode() then actions[#actions + 1] = "G" end
                            -- the game's own move and M1 actions first: they work in the background and
                            -- leave your mouse alone. real key presses are the fallback
                            local useActions = gameAction("MouseClick") ~= nil
                            for index = 1, 4 do
                                if farm.attacks[tostring(index)] and (not farm.onlyReady or Game.ownMoveReady(index)) then
                                    if useActions and tapAction("Move" .. index) then
                                        actions[#actions + 1] = tostring(index)
                                    elseif canKeyClick and canInput() then
                                        keyclick(0x30 + index)
                                        actions[#actions + 1] = tostring(index)
                                    end
                                end
                            end
                            if farm.attacks.M1 then
                                if useActions then
                                    tapAction("MouseClick")
                                    actions[#actions + 1] = "M1"
                                elseif click and canInput() then
                                    local camera = workspace.CurrentCamera
                                    if camera and canAimMouse then
                                        mousemoveabs(math.max(1, math.floor(camera.ViewportSize.X * 0.82)),
                                            math.max(1, math.floor(camera.ViewportSize.Y * 0.5)))
                                    end
                                    click()
                                    actions[#actions + 1] = "M1"
                                end
                            end
                        end)
                        if not ok then
                            farm.last = "input failed: " .. tostring(reason)
                        elseif #actions > 0 then
                            farm.last = "on " .. current.name .. " (" .. table.concat(actions, " ") .. ")"
                        else
                            farm.last = "on " .. current.name .. " (waiting for cooldowns)"
                        end
                    end
                end
                task.wait(0.15)
            else
                task.wait(0.25)
            end
        end
    end)
    onCleanup(function() farm.enabled = false current = nil end)
end

---------------------------------------------------------------------------------------------
-- Auto block. An enemy's M1 shows up as a one-shot animation about 0.2s before it lands, and a
-- move adds a "UsingSkill" value to their character as it starts. Either one, close enough,
-- holds block for a moment through the game's own Block action. Moves tagged "Guardbreaks" go
-- straight through block, so those are left alone. The 5th hit of an M1 chain knocks block
-- off and the game refuses it for a few seconds; nothing input-side gets around that.
---------------------------------------------------------------------------------------------
local autoBlock = {enabled = false, range = 14, hold = 0.45, skipGuardbreaks = true, whileFarming = false,
    last = "off", blocks = 0}
state.AutoBlock = autoBlock
do
    local CollectionService = game:GetService("CollectionService")
    local holdUntil, holding, pressedAt = 0, false, 0
    local watched = setmetatable({}, {__mode = "k"})

    -- when you hit someone their flinch is a one-shot animation too, so for a moment after any
    -- attack of yours (your own presses or the farm's) those don't count
    local lastOwnAttack = -math.huge
    for _, name in ipairs({"MouseClick", "Move1", "Move2", "Move3", "Move4", "Move5"}) do
        local action = gameAction(name)
        if action then connect(action.Pressed, function() lastOwnAttack = os.clock() end) end
    end

    local function myRoot() return Game.ownRoot() end

    -- other players by team setting; dummies and anything without a player always count
    local function isEnemy(model)
        if model == player.Character then return false end
        local owner = Players:GetPlayerFromCharacter(model)
        if not owner then return true end
        return not Game.sameTeam(owner)
    end

    local function breaksGuard(model, skill)
        local owner = Players:GetPlayerFromCharacter(model)
        local backpack = owner and owner:FindFirstChildOfClass("Backpack")
        local move = backpack and backpack:FindFirstChild(skill)
        return move ~= nil and CollectionService:HasTag(move, "Guardbreaks")
    end

    local function trigger(model, root, seconds, reach, why)
        if not autoBlock.enabled or not alive then return end
        local mine = myRoot()
        if not mine or (root.Position - mine.Position).Magnitude > reach then return end
        if not isEnemy(model) then return end
        if not autoBlock.whileFarming and farm.enabled then return end
        holdUntil = math.max(holdUntil, os.clock() + seconds)
        autoBlock.last = why
    end

    local function watch(model)
        if watched[model] or model == player.Character then return end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if not (animator and root) then return end
        watched[model] = true
        connect(animator.AnimationPlayed, function(track)
            if track.Looped or os.clock() - lastOwnAttack < 0.5 then return end
            trigger(model, root, autoBlock.hold, autoBlock.range, "blocking an attack from " .. model.Name)
        end)
        connect(model.ChildAdded, function(child)
            if child.Name ~= "UsingSkill" or not child:IsA("StringValue") then return end
            task.defer(function()
                local skill = Game.usingSkill(model)
                if not skill then return end
                if autoBlock.skipGuardbreaks and breaksGuard(model, skill) then
                    autoBlock.last = skill .. " breaks guard, not blocking"
                    return
                end
                trigger(model, root, 0.8, autoBlock.range * 2, "blocking " .. skill)
            end)
        end)
    end

    local live = workspace:FindFirstChild("Live")
    if live then
        for _, model in ipairs(live:GetChildren()) do pcall(watch, model) end
        connect(live.ChildAdded, function(model) task.defer(function() pcall(watch, model) end) end)
    end

    local function setBlock(on)
        local action = gameAction("Block")
        if action then action:Fire(on) end
    end

    connect(RunService.Heartbeat, function()
        local want = autoBlock.enabled and alive and os.clock() < holdUntil and myRoot() ~= nil
        local character = player.Character
        local blocking = character and Game.isBlocking(character)
        if want and not holding then
            holding, pressedAt = true, os.clock()
            setBlock(true)
            autoBlock.blocks = autoBlock.blocks + 1
        elseif not want and holding then
            holding = false
            setBlock(false)
        elseif want and holding and not blocking and os.clock() - pressedAt > 0.2 then
            -- block got knocked off while we still want it up: let go and press again
            setBlock(false)
            setBlock(true)
            pressedAt = os.clock()
        end
    end)

    autoBlock.SetEnabled = function(value)
        autoBlock.enabled = value == true and alive
        autoBlock.last = autoBlock.enabled and "watching" or "off"
        if not autoBlock.enabled and holding then
            holding = false
            setBlock(false)
        end
    end
    onCleanup(function()
        autoBlock.enabled = false
        if holding then holding = false setBlock(false) end
    end)
end

---------------------------------------------------------------------------------------------
-- Auto rejoin. When Roblox shows a kick or disconnect message, rejoin the game. If a loader is
-- set, it is queued to run again in the new server so everything comes back on its own.
---------------------------------------------------------------------------------------------
local rejoin = {enabled = false, loader = "", last = "off"}
state.Rejoin = rejoin
do
    local GuiService = game:GetService("GuiService")
    local busy = false
    local function go(message)
        if busy or not rejoin.enabled or not alive then return end
        busy = true
        rejoin.last = "disconnected: " .. tostring(message):sub(1, 60)
        task.wait(1)
        if rejoin.loader ~= "" and type(queue_on_teleport) == "function" then
            pcall(queue_on_teleport, rejoin.loader)
        end
        for attempt = 1, 10 do
            if not alive then break end
            rejoin.last = "rejoining (try " .. attempt .. ")"
            pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
            task.wait(8)
        end
        busy = false
    end
    connect(GuiService.ErrorMessageChanged, function(message)
        if message and message ~= "" then task.spawn(go, message) end
    end)
end

