        Nanami = characterTabs.Nanami}
    local function openTab(character)
        task.wait(1.5)
        if not alive or not misc.autoTab or player.Character ~= character then return end
        local loadedName = character:GetAttribute("LastLoadedChar")
        if type(loadedName) ~= "string" then return end
        for key, tab in pairs(tabFor) do
            if string.find(loadedName, key, 1, true) then pcall(function() tab:Select() end) return end
        end
    end
    connect(player.CharacterAdded, function(character) task.spawn(openTab, character) end)
end

