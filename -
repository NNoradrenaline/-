-- theme plumbing

function Window:bind(obj, prop, token)
    obj[prop] = self.T[token]
    table.insert(self.Bound, {obj = obj, prop = prop, token = token})
    return obj
end

-- a border that follows the theme
local function bstroke(win, parent, token, thickness, transparency)
    local s = stroke(win.T[token], thickness, transparency)
    s.Parent = parent
    win:bind(s, "Color", token)
    return s
end

function Window:icon(parent, name, size, color, props)
    props = props or {}
    local img = new("ImageLabel", {
        BackgroundTransparency = 1, AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
        Position = props.Position or UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size),
        ZIndex = props.ZIndex or 1, Parent = parent,
    })
    if type(color) == "string" then self:bind(img, "ImageColor3", color) else img.ImageColor3 = color or self.T.Text end
    U.setIcon(img, name)
    return img
end

function Window:_rebuildTokens()
    local fresh = buildTokens(self.ThemeName, self.AccentName, self.CustomAccent)
    for k in pairs(self.T) do self.T[k] = nil end
    for k, v in pairs(fresh) do self.T[k] = v end
end

function Window:_apply(animate)
    for i = #self.Bound, 1, -1 do
        local b = self.Bound[i]
        if not b.obj.Parent then
            table.remove(self.Bound, i)
        elseif animate then
            tween(b.obj, 0.25, {[b.prop] = self.T[b.token]})
        else
            b.obj[b.prop] = self.T[b.token]
        end
    end
    for _, fn in ipairs(self.Redraws) do pcall(fn) end
end

function Window:SetTheme(name)
    if not themeActive(name) then return end
    self.ThemeName = name
    self.ThemeChosen = true
    self:_rebuildTokens()
    self:_apply(true)
    self:_fxSync()
    self:_save()
end

-- halloween: embers drifting up behind the content, a ghost in the logo tile and a slow
-- light along the top edge. all of it is removed again when another theme is picked
function Window:_fxStop()
    local fx = self.Fx
    if not fx then return end
    self.Fx = nil
    fx.alive = false
    for _, o in ipairs(fx.objs) do pcall(function() o:Destroy() end) end
    if self.BrandMark and self.BrandMark.Parent then self.BrandMark.Visible = true end
end

function Window:_fxStart()
    if self.Fx or self.Destroyed or not self.Body then return end
    local fx = {alive = true, objs = {}}
    self.Fx = fx
    local function keep(o) table.insert(fx.objs, o) return o end
    local linear = Enum.EasingStyle.Linear
    local rng = Random.new()

    if self.BrandTile then
        local ghost = keep(self:icon(self.BrandTile, "ghost", 15, "Accent"))
        if self.BrandMark then self.BrandMark.Visible = false end
        TweenService:Create(ghost, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            {Position = UDim2.new(0.5, 0, 0.5, -2)}):Play()
    end

    local glint = keep(new("Frame", {Name = "Glint", BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 0, 0, 2), ZIndex = 40, Parent = self.Body}))
    local grad = new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(255, 122, 24), Color3.fromRGB(160, 100, 230)),
        Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)}),
        Offset = Vector2.new(-1, 0), Parent = glint,
    })
    TweenService:Create(grad, TweenInfo.new(3.2, linear, Enum.EasingDirection.Out, -1, false, 1.2), {Offset = Vector2.new(1, 0)}):Play()

    -- in front of the content but faint and only a few pixels wide, so it never gets in the way of reading
    local holder = keep(new("Frame", {Name = "Embers", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 35, Parent = self.Body}))
    local colors = {Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 108, 20), Color3.fromRGB(165, 105, 235)}
    for _ = 1, 24 do
        task.spawn(function()
            task.wait(rng:NextNumber(0, 8))
            while fx.alive and holder.Parent do
                if U.fast or not self.Open then
                    task.wait(0.5)
                else
                    local size = rng:NextInteger(2, 4)
                    local x = rng:NextNumber(0.03, 0.97)
                    local life = rng:NextNumber(6, 11)
                    local dot = new("Frame", {
                        BackgroundColor3 = colors[rng:NextInteger(1, #colors)], BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(x, 0, 1, 8), Size = UDim2.fromOffset(size, size), Parent = holder,
                    }, {corner(size)})
                    TweenService:Create(dot, TweenInfo.new(life, linear), {Position = UDim2.new(x + rng:NextNumber(-0.06, 0.06), 0, 0, -8)}):Play()
                    TweenService:Create(dot, TweenInfo.new(life * 0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = 0.4}):Play()
                    task.delay(life * 0.55, function()
                        if dot.Parent then
                            TweenService:Create(dot, TweenInfo.new(life * 0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
                        end
                    end)
                    task.wait(life)
                    dot:Destroy()
                end
            end
        end)
    end
end

function Window:_fxSync()
    if self.ThemeName == "Halloween" then self:_fxStart() else self:_fxStop() end
end

-- while the window is hidden a small icon stays on screen. click it to bring the window back,
-- drag it to wherever suits you (the spot is remembered)
local DOCK = 38

function Window:_dockBuild(opts)
    self.DockOn = opts.Dock ~= false
    U.dockSlots = U.dockSlots or {}
    local slot = 1
    while U.dockSlots[slot] do slot = slot + 1 end
    U.dockSlots[slot] = self
    self.DockSlot = slot

    local function viewport()
        local cam = workspace.CurrentCamera
        return cam and cam.ViewportSize or Vector2.new(1280, 720)
    end
    local function clamp(px, py)
        local v = viewport()
        return math.clamp(px, 4, math.max(v.X - DOCK - 4, 4)), math.clamp(py, 4, math.max(v.Y - DOCK - 4, 4))
    end
    local x, y = 14, math.floor(viewport().Y * 0.34) + (slot - 1) * (DOCK + 8)
    local saved = self.Saved.__dock
    if type(saved) == "table" and tonumber(saved.x) and tonumber(saved.y) then x, y = saved.x, saved.y end
    x, y = clamp(x, y)

    local btn = new("TextButton", {
        Name = "Dock", Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(DOCK, DOCK), Visible = false, ZIndex = 10, Parent = self.Gui,
    })
    local scale = new("UIScale", {Scale = 0.85, Parent = btn})
    local face = new("CanvasGroup", {BackgroundColor3 = self.T.Panel, Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Parent = btn}, {corner(10)})
    self:bind(face, "BackgroundColor3", "Panel")
    if opts.Icon then
        self:icon(face, opts.Icon, 18, "Text")
    else
        local letter = text({Text = string.upper(self.Title:sub(1, 1)), FontFace = F.SemiBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center,
            Size = UDim2.fromScale(1, 1), Parent = face})
        self:bind(letter, "TextColor3", "Text")
    end
    local ring = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = btn}, {corner(10)})
    local ringStroke = bstroke(self, ring, "Stroke", 1, 1)
    -- a small dot in the corner, for "something is running". off unless SetBadge turns it on
    local dot = new("Frame", {
        Name = "Badge", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 3, 0, -3), Size = UDim2.fromOffset(9, 9),
        BackgroundTransparency = 1, ZIndex = 5, Parent = btn,
    }, {corner(5)})
    self:bind(dot, "BackgroundColor3", "Good")
    local dotRing = bstroke(self, dot, "Panel", 2, 1)
    self.Dock = {btn = btn, scale = scale, face = face, stroke = ringStroke, dot = dot, dotRing = dotRing, shown = false}

    btn.MouseEnter:Connect(function()
        if not self.Dock.shown then return end
        tween(face, 0.12, {BackgroundColor3 = self.T.Hover})
        tween(ringStroke, 0.12, {Color = self.T.Accent})
    end)
    btn.MouseLeave:Connect(function()
        tween(face, 0.15, {BackgroundColor3 = self.T.Panel})
        tween(ringStroke, 0.15, {Color = self.T.Stroke})
    end)

    -- a press that barely moves is a click, anything more drags the icon
    local dragging, moved, startPos, origin
    local function onBegin(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging, moved, startPos, origin = true, false, input.Position, btn.Position
        local c
        c = input.Changed:Connect(function()
            if input.UserInputState ~= Enum.UserInputState.End then return end
            c:Disconnect()
            dragging = false
            if moved then
                self.DockPos = {x = btn.Position.X.Offset, y = btn.Position.Y.Offset}
                self:_save()
            else
                self:SetOpen(true)
            end
        end)
    end
    local function onMove(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = input.Position - startPos
        if not moved and d.Magnitude < 5 then return end
        moved = true
        local nx, ny = clamp(origin.X.Offset + d.X, origin.Y.Offset + d.Y)
        btn.Position = UDim2.fromOffset(nx, ny)
    end
    btn.InputBegan:Connect(onBegin)
    table.insert(self.Conns, UserInputService.InputChanged:Connect(onMove))
    self.Dock.onBegin, self.Dock.onMove = onBegin, onMove
    self:_dockSync()
end

-- where a window opens. a spot you dragged it to wins. otherwise the middle of the screen, or
-- if another open window is already there, the first free spot beside or below it. it always
-- stays on screen and clear of the roblox top bar
local TOP_CLEAR, EDGE = 64, 12

function Window:_screen()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local s = self:_scale()
    return vp, self.Root.Size.X.Offset * s, self.Root.Size.Y.Offset * s
end

-- clamps a window centre (in pixels) so the whole window is visible
function Window:_clampCentre(cx, cy)
    local vp, w, h = self:_screen()
    cx = math.clamp(cx, w / 2 + EDGE, math.max(w / 2 + EDGE, vp.X - w / 2 - EDGE))
    cy = math.clamp(cy, h / 2 + TOP_CLEAR, math.max(h / 2 + TOP_CLEAR, vp.Y - h / 2 - EDGE))
    return cx, cy
end

function Window:_moveCentre(cx, cy)
    local vp = self:_screen()
    cx, cy = self:_clampCentre(cx, cy)
    local was = self.Dragged
    self.Dragged = false
    self.Root.Position = UDim2.new(0.5, math.floor(cx - vp.X / 2 + 0.5), 0.5, math.floor(cy - vp.Y / 2 + 0.5))
    self.Dragged = was
end

function Window:_place()
    local vp, w, h = self:_screen()
    local saved = self.Saved.__pos
    if type(saved) == "table" and tonumber(saved.x) and tonumber(saved.y) then
        self.PosSaved = {x = tonumber(saved.x), y = tonumber(saved.y)}
        self:_moveCentre(vp.X / 2 + saved.x, vp.Y / 2 + saved.y)
        return
    end
    local others = {}
    for _, o in ipairs(U.windows or {}) do
        if o ~= self and not o.Destroyed and o.Open and o.Root and o.Root.Visible then
            table.insert(others, {c = o.Root.AbsolutePosition + o.Root.AbsoluteSize / 2, size = o.Root.AbsoluteSize})
        end
    end
    local function free(x, y)
        for _, r in ipairs(others) do
            if math.abs(x - r.c.X) < (w + r.size.X) / 2 + 8 and math.abs(y - r.c.Y) < (h + r.size.Y) / 2 + 8 then return false end
        end
        return true
    end
    local spots = {{vp.X / 2, vp.Y / 2}}
    for _, r in ipairs(others) do
        table.insert(spots, {r.c.X + (r.size.X + w) / 2 + 16, r.c.Y})
        table.insert(spots, {r.c.X - (r.size.X + w) / 2 - 16, r.c.Y})
        table.insert(spots, {r.c.X, r.c.Y + (r.size.Y + h) / 2 + 16})
    end
    for _, spot in ipairs(spots) do
        local x, y = self:_clampCentre(spot[1], spot[2])
        if free(x, y) then self:_moveCentre(x, y) return end
    end
    -- no free room: step down and right from the newest window so both title bars show
    local last = others[#others]
    self:_moveCentre(last.c.X + 36, last.c.Y + 36)
end

-- after the screen size changes, pull the window back if it ended up off screen
function Window:_keepOnScreen()
    local c = self.Root.AbsolutePosition + self.Root.AbsoluteSize / 2
    self:_moveCentre(c.X, c.Y)
end

-- forget a dragged position and pick a spot again
function Window:ResetPosition()
    self.PosSaved, self.Saved.__pos = nil, nil
    self:_place()
    self:_save()
end

-- turns the dot on the floating icon on or off
function Window:SetBadge(on)
    local d = self.Dock
    if not d then return end
    on = on == true
    d.badge = on
    tween(d.dot, 0.2, {BackgroundTransparency = on and 0 or 1})
    tween(d.dotRing, 0.2, {Transparency = on and 0 or 1})
end

function Window:_dockSync()
    local d = self.Dock
    if not d then return end
    local show = self.DockOn == true and not self.Open and not self.Destroyed
    if show == d.shown then return end
    d.shown = show
    if show then
        d.btn.Visible = true
        tween(d.scale, 0.25, {Scale = 1})
        tween(d.face, 0.2, {GroupTransparency = 0})
        tween(d.stroke, 0.2, {Transparency = 0})
    else
        tween(d.scale, 0.15, {Scale = 0.85})
        tween(d.face, 0.15, {GroupTransparency = 1})
        tween(d.stroke, 0.15, {Transparency = 1})
        task.delay(0.18, function() if not d.shown and d.btn.Parent then d.btn.Visible = false end end)
    end
end

function Window:SetAccent(a)
    if type(a) == "string" and ACCENTS[a] then
        self.AccentName, self.CustomAccent = a, nil
    elseif typeof(a) == "Color3" then
        self.AccentName, self.CustomAccent = nil, a
    else
        return
    end
    self:_rebuildTokens()
    self:_apply(true)
    self:_save()
end

function Window:SetKey(key)
    if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
        self.Key = key
        self:_save()
    end
end

function Window:SetScale(v)
    self.UserScale = math.clamp(tonumber(v) or 1, 0.6, 1.5)
    if self.Open then tween(self.Scale, 0.25, {Scale = self:_scale()}) end
    self:_save()
end

function Window:_scale() return (self.BaseScale or 1) * (self.UserScale or 1) end

-- config, debounced so sliders don't write every frame

function Window:_flush()
    if not self.ConfigPath then return end
    local out = {}
    for k, v in pairs(self.Saved) do out[k] = v end -- keep values for flags that haven't been created yet
    for flag, f in pairs(self.Flags) do
        local ok, v = pcall(f.Save)
        if ok and v ~= nil then out[flag] = v end
    end
    out.__accent = self.AccentName
    if self.ThemeChosen then out.__theme = self.ThemeName end
    if self.DockPos then out.__dock = self.DockPos end
    if self.PosSaved then out.__pos = self.PosSaved end
    out.__key, out.__scale, out.__blur = self.Key and self.Key.Name, self.UserScale, self.BlurPref
    local ok, json = pcall(HttpService.JSONEncode, HttpService, out)
    if ok then fs.write(self.ConfigPath, json) end
end

function Window:_save()
    if not self.ConfigPath or self.Loading then return end
    self.SaveQueued = true
    if self.SaveRunning then return end
    self.SaveRunning = true
    task.delay(0.8, function()
        self.SaveRunning = false
        if not self.SaveQueued or self.Destroyed then return end
        self.SaveQueued = false
        self:_flush()
    end)
end

function Window:_flag(flag, get, set, save, load)
    if not flag then return nil end
    self.Flags[flag] = {Get = get, Set = set, Save = save or get}
    local saved = self.Saved[flag]
    if saved ~= nil then
        local ok, v = pcall(load or function(x) return x end, saved)
        if ok and v ~= nil then return v end
    end
    return nil
end

-- search index: every element registers itself so the top bar can jump to it

function Window:_index(tab, name, desc, row, sec)
    if not name or name == "" then return end
    table.insert(self.Index, {name = tostring(name), desc = tostring(desc or ""), tab = tab, row = row, sec = sec})
end

-- brief highlight on a row, used when search jumps to it
function Window:_flash(row)
    if not row.Parent then return end
    local prevColor = row.BackgroundColor3
    row.BackgroundColor3 = self.T.Accent
    tween(row, 0.1, {BackgroundTransparency = 0.82})
    task.delay(0.9, function()
        if not row.Parent then return end
        tween(row, 0.5, {BackgroundTransparency = 1}).Completed:Connect(function()
            if row.Parent then row.BackgroundColor3 = self.T.Hover end
        end)
    end)
end

-- constructor

function Vanta:Window(opts)
    opts = opts or {}
    -- the local player can still be missing when the library first loads, so look again here
    plr = Players.LocalPlayer or plr
    while not plr do task.wait() plr = Players.LocalPlayer end
    U.loadFonts()
    local self = setmetatable({}, Window)
    self.Title = opts.Title or "Vanta"
    self.Subtitle = opts.Subtitle or ""
    self.Key = (typeof(opts.Key) == "EnumItem" and opts.Key.EnumType == Enum.KeyCode) and opts.Key or Enum.KeyCode.RightControl
    self.OnDestroy = opts.OnDestroy
    self.Tabs, self.Flags, self.Conns, self.Bound = {}, {}, {}, {}
    self.Redraws, self.Index, self.Binds, self.SideLabels = {}, {}, {}, {}
    self.Toggles = {}
    U.windows = U.windows or {}
    table.insert(U.windows, self)
    self.Open, self.Destroyed, self.OrderCount = true, false, 0
    self.UserScale, self.BlurPref = 1, opts.Blur == true
    self.SideCollapsed = false
    self.ThemeName = themeActive(opts.Theme) and opts.Theme or "Graphite"
    self.AccentName = ACCENTS[opts.Accent] and opts.Accent or "Mono"

    -- saved settings
    self.ConfigPath = opts.Config and (tostring(opts.Config) .. "/settings.json") or nil
    self.Saved = {}
    if self.ConfigPath then
        local raw = fs.read(self.ConfigPath)
        if raw then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok and type(data) == "table" then self.Saved = data end
        end
        local s = self.Saved
        if type(s.__theme) == "string" and themeActive(s.__theme) then self.ThemeName = s.__theme end
        -- only a theme someone picked gets saved, so a default can still change later (the seasonal one)
        self.ThemeChosen = type(s.__theme) == "string" and s.__theme == self.ThemeName
        if type(s.__accent) == "string" and ACCENTS[s.__accent] then self.AccentName = s.__accent end
        if type(s.__key) == "string" then
            local ok, k = pcall(function() return Enum.KeyCode[s.__key] end)
            if ok and k then self.Key = k end
        end
        if type(s.__scale) == "number" then self.UserScale = math.clamp(s.__scale, 0.6, 1.5) end
        if type(s.__blur) == "boolean" then self.BlurPref = s.__blur end
    end

    self.T = {}
    self:_rebuildTokens()
    local T = self.T

    local size = opts.Size or UDim2.fromOffset(660, 440)
    local gui = screenGui("Vanta_" .. HttpService:GenerateGUID(false):sub(1, 8), 150)
    self.Gui = gui

    local root = new("Frame", {
        Name = "Window", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = size, Parent = gui,
    })
    self.Root = root
    self.Scale = new("UIScale", {Scale = 1, Parent = root})

    local function fit()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local w, h = self.Root.Size.X.Offset, self.Root.Size.Y.Offset
        self.BaseScale = math.max(math.min(1, (vp.X - 24) / w, (vp.Y - 24) / h), 0.45)
        if self.Open and self.Booted then
            self.Scale.Scale = self:_scale()
            task.defer(function() if not self.Destroyed then self:_keepOnScreen() end end)
        end
    end
    if workspace.CurrentCamera then
        table.insert(self.Conns, workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit))
    end

    -- a soft shadow, kept faint
    self.Shadow = new("ImageLabel", {
        Name = "Shadow", BackgroundTransparency = 1, Image = U.assets.Glow, ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = 0.7, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 14),
        Size = UDim2.new(1, 120, 1, 120), ZIndex = 0, Parent = root,
    })

    -- body: a canvas group so the whole window can fade as one
    local body = new("CanvasGroup", {
        Name = "Body", BackgroundColor3 = T.Background, Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Parent = root,
    }, {corner(10)})
    self:bind(body, "BackgroundColor3", "Background")
    self.Body = body

    -- hairline border, drawn above the body so the canvas group can't clip it
    local border = new("Frame", {Name = "Border", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 30, Parent = root}, {corner(10)})
    bstroke(self, border, "Stroke", 1, 0)
    self.Border = border

    -- sidebar
    local sidebar = new("Frame", {Name = "Sidebar", BackgroundColor3 = T.Sidebar, Size = UDim2.new(0, SIDE_OPEN, 1, 0),
        ClipsDescendants = true, ZIndex = 2, Parent = body})
    self:bind(sidebar, "BackgroundColor3", "Sidebar")
    self.Sidebar = sidebar
    local sideLine = new("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), Parent = sidebar})
    self:bind(sideLine, "BackgroundColor3", "Stroke")

    local brand = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 58), Parent = sidebar})
    local tile = new("Frame", {BackgroundColor3 = T.Element, Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(26, 26), Parent = brand}, {corner(7)})
    self:bind(tile, "BackgroundColor3", "Hover")
    bstroke(self, tile, "Stroke", 1, 0)
    self.BrandTile = tile
    if opts.Icon then
        self.BrandMark = self:icon(tile, opts.Icon, 14, "Text")
    else
        local letter = text({Text = string.upper(self.Title:sub(1, 1)), FontFace = F.SemiBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center,
