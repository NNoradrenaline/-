    local avatar = new("ImageLabel", {BackgroundColor3 = T.Hover, Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(24, 24), Parent = profile}, {corner(12)})
    self:bind(avatar, "BackgroundColor3", "Hover")
    local nameLbl = text({Text = plr.DisplayName, FontFace = F.Medium, TextSize = 12, Position = UDim2.fromOffset(46, 10),
        Size = UDim2.new(1, -54, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile})
    self:bind(nameLbl, "TextColor3", "Text")
    self.StatLbl = text({Text = "", TextSize = 11, Position = UDim2.fromOffset(46, 26), Size = UDim2.new(1, -54, 0, 14),
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile})
    self:bind(self.StatLbl, "TextColor3", "Muted")
    table.insert(self.SideLabels, nameLbl)
    table.insert(self.SideLabels, self.StatLbl)
    task.spawn(function()
        local ok, img = pcall(Players.GetUserThumbnailAsync, Players, plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        if ok and avatar.Parent then avatar.Image = img end
    end)

    -- content side
    local content = new("Frame", {Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(SIDE_OPEN, 0),
